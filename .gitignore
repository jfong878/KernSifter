# Rust
/target
**/target/

# Node (Tauri frontend)
node_modules/
dist/
build/

# Tauri generated schemas (regenerated by tauri-build)
desktop-ui/src-tauri/gen/

# Flutter / Android / iOS
.gradle/
build/
android/.gradle/
ios/Pods/
# Dart tool cache (regenerated by `flutter pub get`; not source).
mobile-ui/.dart_tool/
mobile-ui/.flutter-plugins
mobile-ui/.flutter-plugins-dependencies
mobile-ui/android/local.properties
# `pubspec.lock` is deliberately NOT ignored: this is an application, not a
# package, so its resolved dependency versions are part of the build.

# Tauri updater signing key material. The private key must never be committed;
# CI reads it from the TAURI_SIGNING_PRIVATE_KEY repository secret.
desktop-ui/.tauri/

# Agent / tool scratch (never committed)
.freebuff/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Agent / tool attachments (never committed)
.cloud-attachments/
